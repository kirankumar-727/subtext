# Copy to supabase/functions/.env for local development. Never commit the real file.
FOUNDER_EMAIL=founder@example.com
BEFORE_USER_CREATED_HOOK_SECRET=v1,whsec_replace_with_base64_secret
CUSTOM_ACCESS_TOKEN_HOOK_SECRET=v1,whsec_replace_with_different_base64_secret

# Publishing worker invocation and public application coordination
PUBLISHING_WORKER_SECRET=replace_with_at_least_32_random_bytes
PUBLICATION_API_URL=http://host.docker.internal:3000
REVALIDATION_SECRET=replace_with_a_different_32_byte_secret
