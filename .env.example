# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Supabase project API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase credential. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Bootstrap admission rule; authorization is enforced by Supabase hooks and RLS.
FOUNDER_EMAIL=founder@example.com

# Generate independent values of at least 32 random bytes for each environment.
PUBLISHING_SIGNING_SECRET=replace_with_a_random_secret
REVALIDATION_SECRET=replace_with_a_different_random_secret
CRON_SECRET=replace_with_a_third_random_secret

# Google OAuth provider configuration for Supabase Auth (server/deployment only)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace_with_google_oauth_client_secret

# Standard Webhooks secrets generated for each Supabase Auth HTTP hook.
BEFORE_USER_CREATED_HOOK_SECRET=v1,whsec_replace_with_base64_secret
CUSTOM_ACCESS_TOKEN_HOOK_SECRET=v1,whsec_replace_with_different_base64_secret

# Required only by the production Auth configuration script.
SUPABASE_PROJECT_REF=replace_with_project_ref
SUPABASE_ACCESS_TOKEN=replace_with_personal_access_token

# Publishing worker invocation (server/cron only)
PUBLISHING_WORKER_SECRET=replace_with_at_least_32_random_bytes
PUBLICATION_API_URL=https://subtext.media
