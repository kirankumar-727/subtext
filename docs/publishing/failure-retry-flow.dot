digraph G{rankdir=TB;node[shape=box,style="rounded,filled",fillcolor="#fbf8f1"];Failure->Classify;Classify[shape=diamond,label="Retryable?"];Classify->Dead[label="no"];Classify->Attempts[label="yes"];Attempts[shape=diamond,label="Attempts remain?"];Attempts->Dead[label="no"];Attempts->Backoff[label="yes"];Backoff->Failed->Reclaim->Resume;Resume[shape=diamond,label="Committed already?"];Resume->Validate[label="no"];Resume->Verify[label="yes"];Dead[label="dead_letter + event"];}
